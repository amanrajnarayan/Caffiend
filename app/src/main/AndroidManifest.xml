<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Caffiend"
        tools:targetApi="31">

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- About/FYI Activity -->
        <activity
            android:name=".MainActivity3"
            android:exported="false" />

        <!-- Graph Activity -->
        <activity
            android:name=".MainActivity2"
            android:exported="false" />

        <!-- Main Activity (Launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Worker for random/over-limit notifications -->
        <service
            android:name=".NotificationWorker"
            android:enabled="true"
            android:exported="false"
            tools:ignore="Instantiatable" />

        <!-- Receiver for bedtime notifications -->
        <receiver
            android:name=".BedtimeReceiver"
            android:enabled="true"
            android:exported="true" />
    </application>
</manifest>
